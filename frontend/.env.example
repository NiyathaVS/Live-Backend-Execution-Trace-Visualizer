# WebSocket Configuration
# The WebSocket URL for connecting to the trace backend
# Default: ws://localhost:8080/ws/traces (or wss:// for HTTPS)
VITE_WS_URL=ws://localhost:8080/ws/traces

# Alternative: API Base URL (WebSocket URL will be derived from this)
# If VITE_WS_URL is not set, the app will use this to construct the WebSocket URL
# VITE_API_URL=http://localhost:8080

# Production Example:
# VITE_WS_URL=wss://api.myapp.com/ws/traces
# VITE_API_URL=https://api.myapp.com